{
  "mcpServers": {
    "cc-explorer": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec env UV_CACHE_DIR=\"${TMPDIR:-/tmp}/cc-explorer/uv-cache\" UV_PROJECT_ENVIRONMENT=\"${TMPDIR:-/tmp}/cc-explorer/.venv\" uv run --project . cc-explorer"
      ],
      "cwd": ".",
      "startup_timeout_sec": 30
    }
  }
}
