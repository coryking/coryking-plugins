{
  "name": "project-mining",
  "version": "3.0.0",
  "description": "Read agent history and gather original evidence for project and attention analysis.",
  "author": {
    "name": "Cory King",
    "email": "me@coryk.ing",
    "url": "https://github.com/coryking"
  },
  "homepage": "https://github.com/coryking/coryking-plugins",
  "repository": "https://github.com/coryking/coryking-plugins",
  "license": "MIT",
  "keywords": [
    "chat-history",
    "evidence-mining",
    "project-mining",
    "cc-explorer",
    "mcp"
  ],
  "agents": [
    "./agents/evidence-worker.md",
    "./agents/activity-analyst.md"
  ],
  "skills": [
    "./skills/cc-explorer",
    "./skills/project-mining",
    "./skills/activity-reflection"
  ],
  "mcpServers": {
    "cc-explorer": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "cc-explorer"
      ]
    }
  }
}
